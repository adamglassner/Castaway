<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Every key here must also exist in Dark.xaml. The sidebar stays dark in both themes. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F4F3EF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EEEDE8" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E1DFD8" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#E6E4DD" />
    <SolidColorBrush x:Key="Brush.Track" Color="#D9D7D0" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1A1C20" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#5E6168" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#10000000" />

    <SolidColorBrush x:Key="Brush.Header" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Search" Color="#EEEDE8" />

    <SolidColorBrush x:Key="Brush.Sidebar" Color="#1A1C20" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="#C9C7C1" />
    <SolidColorBrush x:Key="Brush.SidebarLabel" Color="#8E9097" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#24272C" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#2C2F35" />
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#24272C" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#F2B33D" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#1A1C20" />
    <SolidColorBrush x:Key="Brush.AccentInk" Color="#8A5A00" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FBEBC8" />

    <SolidColorBrush x:Key="Brush.LiveBg" Color="#E2F3E8" />
    <SolidColorBrush x:Key="Brush.LiveText" Color="#1F6B3E" />
    <SolidColorBrush x:Key="Brush.LiveDot" Color="#2E9E5B" />

    <SolidColorBrush x:Key="Brush.ToastBg" Color="#1A1C20" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#FFFFFF" />
</ResourceDictionary>
