<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (the Castaway mockup's look). Every key here must also exist in Light.xaml. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#16181C" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1E2126" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#262930" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2C3038" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#2A2E35" />
    <SolidColorBrush x:Key="Brush.Track" Color="#3A3E46" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E8E6E1" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#9A9CA3" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="Brush.Header" Color="#0F1013" />
    <SolidColorBrush x:Key="Brush.Search" Color="#1F2227" />

    <SolidColorBrush x:Key="Brush.Sidebar" Color="#121317" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="#C9C7C1" />
    <SolidColorBrush x:Key="Brush.SidebarLabel" Color="#8B8D93" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#1C1E23" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#24272D" />
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#1A1C21" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#F2B33D" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#16181C" />
    <SolidColorBrush x:Key="Brush.AccentInk" Color="#F2B33D" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#33291A" />

    <SolidColorBrush x:Key="Brush.LiveBg" Color="#1C2A22" />
    <SolidColorBrush x:Key="Brush.LiveText" Color="#7FD3A0" />
    <SolidColorBrush x:Key="Brush.LiveDot" Color="#4CC47D" />

    <SolidColorBrush x:Key="Brush.ToastBg" Color="#E8E6E1" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#16181C" />
</ResourceDictionary>
